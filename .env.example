# ============================================================================
# PR Monitor Agent v2.1 — Environment Variables
# Copy this file to .env.local and fill in real values.
# In Vercel, set the same variables under Project Settings → Environment Variables.
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED — Claude (Anthropic) API key
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ----------------------------------------------------------------------------
# OPTIONAL — extra news sources
# ----------------------------------------------------------------------------
NEWSAPI_KEY=
BING_NEWS_API_KEY=

# ----------------------------------------------------------------------------
# REQUIRED for email — AWS SES SMTP
# ----------------------------------------------------------------------------
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIA_YOUR_SES_SMTP_USERNAME
SMTP_PASS=YOUR_SES_SMTP_PASSWORD
SMTP_FROM="PR Monitor <pr-monitor@yourverifieddomain.com>"

# ----------------------------------------------------------------------------
# Freshness window — keep only articles published within this many hours.
# Articles with NO publish date are kept anyway and flagged "undated" in the UI.
# ----------------------------------------------------------------------------
FRESHNESS_HOURS=72

# ----------------------------------------------------------------------------
# Cron security & callback URL
# ----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
CRON_SECRET=replace_me_with_a_long_random_string

# Set to your prod URL (e.g. https://pr-monitor-v2.vercel.app).
# Used by /api/cron-send to call /api/agent-search and /api/send-email internally.
# If unset, falls back to VERCEL_URL (auto-set by Vercel) — works for *.vercel.app.
PUBLIC_BASE_URL=

# ----------------------------------------------------------------------------
# Per-company email recipients (used by the cron job)
# Pattern:
#   RECIPIENTS_<NAME>      → comma-separated TO list
#   RECIPIENTS_<NAME>_CC   → comma-separated CC list
# Name normalization: uppercase, non-alphanumerics → underscore.
#   "BeOne" → RECIPIENTS_BEONE
# ----------------------------------------------------------------------------
RECIPIENTS_GSK=client-gsk@example.com
RECIPIENTS_GSK_CC=manager@yourfirm.com

RECIPIENTS_BEONE=client-beone@example.com
RECIPIENTS_OTSUKA=client-otsuka@example.com
RECIPIENTS_MAZDA=client-mazda@example.com
RECIPIENTS_TRANE=client-trane@example.com
RECIPIENTS_AMGEN=client-amgen@example.com
RECIPIENTS_INDIVIOR=client-indivior@example.com

# Fallback when a per-company var is unset
DEFAULT_RECIPIENTS=ops@yourfirm.com
DEFAULT_CC=
